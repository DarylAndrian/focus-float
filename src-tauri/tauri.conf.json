{
  "productName": "FocusFloat",
  "version": "1.0.0",
  "identifier": "com.darylandrian.focusfloat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FocusFloat",
        "width": 480,
        "height": 680,
        "resizable": false,
        "transparent": false,
        "backgroundColor": "#1a1a2e"
      },
      {
        "label": "pip",
        "title": "FocusFloat PiP",
        "url": "pip.html",
        "width": 220,
        "height": 170,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
